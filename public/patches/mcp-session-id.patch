@@ -0,0 +1,31 @@
+import unittest
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import tools
+
+
+class GetCartQueryContractTests(unittest.IsolatedAsyncioTestCase):
+    async def test_user_id_is_sent_as_session_id_query_parameter(self):
+        user_id = "public-cart-session"
+        payload = {"userId": user_id, "items": []}
+        response = MagicMock()
+        response.json.return_value = payload
+
+        client = MagicMock()
+        client.__aenter__ = AsyncMock(return_value=client)
+        client.__aexit__ = AsyncMock(return_value=None)
+        client.get = AsyncMock(return_value=response)
+
+        with patch.object(tools.httpx, "AsyncClient", return_value=client) as factory:
+            result = await tools.get_cart(user_id)
+
+        factory.assert_called_once_with(timeout=tools.TIMEOUT)
+        client.get.assert_awaited_once_with(
+            f"http://{tools.BASE_URL}/api/cart", params={"sessionId": user_id}
+        )
+        response.raise_for_status.assert_called_once_with()
+        self.assertEqual(result, payload)
+
+
+if __name__ == "__main__":
+    unittest.main()
